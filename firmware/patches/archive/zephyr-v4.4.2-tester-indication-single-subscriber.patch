+struct indication_subscriber {
+	const struct bt_gatt_attr *attr;
+	struct bt_conn *conn;
+	size_t count;
+};
+
+static void find_indication_subscriber(struct bt_conn *conn, void *user_data)
+{
+	struct indication_subscriber *subscriber = user_data;
+
+	if (!bt_gatt_is_subscribed(conn, subscriber->attr, BT_GATT_CCC_INDICATE)) {
+		return;
+	}
+
+	subscriber->count++;
+	if (subscriber->count == 1U) {
+		subscriber->conn = bt_conn_ref(conn);
+	}
+}
+
+static int indicate_single_subscriber(struct bt_gatt_indicate_params *params)
+{
+	struct indication_subscriber subscriber = { .attr = params->attr };
+	int err;
+
+	bt_conn_foreach(BT_CONN_TYPE_LE, find_indication_subscriber, &subscriber);
+	if (subscriber.count != 1U) {
+		if (subscriber.conn) {
+			bt_conn_unref(subscriber.conn);
+		}
+
+		return subscriber.count == 0U ? -ENOTCONN : -E2BIG;
+	}
+
+	err = bt_gatt_indicate(subscriber.conn, params);
+	bt_conn_unref(subscriber.conn);
+	return err;
+}
