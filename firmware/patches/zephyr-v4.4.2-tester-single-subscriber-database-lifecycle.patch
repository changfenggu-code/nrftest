+struct gatt_subscriber {
+	const struct bt_gatt_attr *attr;
+	uint16_t ccc_type;
+	struct bt_conn *conn;
+	size_t count;
+};
+
+static void find_gatt_subscriber(struct bt_conn *conn, void *user_data)
+{
+	struct gatt_subscriber *subscriber = user_data;
+
+	if (!bt_gatt_is_subscribed(conn, subscriber->attr, subscriber->ccc_type)) {
+		return;
+	}
+
+	subscriber->count++;
+	if (subscriber->count == 1U) {
+		subscriber->conn = bt_conn_ref(conn);
+	}
+}
+
+static int get_single_subscriber(const struct bt_gatt_attr *attr, uint16_t ccc_type,
+				 struct bt_conn **conn)
+{
+	struct gatt_subscriber subscriber = {
+		.attr = attr,
+		.ccc_type = ccc_type,
+	};
+
+	bt_conn_foreach(BT_CONN_TYPE_LE, find_gatt_subscriber, &subscriber);
+	if (subscriber.count != 1U) {
+		if (subscriber.conn) {
+			bt_conn_unref(subscriber.conn);
+		}
+
+		return subscriber.count == 0U ? -ENOTCONN : -E2BIG;
+	}
+
+	*conn = subscriber.conn;
+	return 0;
+}
