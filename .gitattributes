# Keep source and patch files stable across Windows, macOS, and Linux checkouts.
* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.overlay text eol=lf
*.patch text eol=lf -whitespace
*.hex text eol=lf
justfile text eol=lf

*.ps1 text eol=crlf

*.zip binary
*.whl binary
*.exe binary
*.bin binary
*.elf binary

pixi.lock text eol=lf merge=binary linguist-language=YAML linguist-generated=true -diff
